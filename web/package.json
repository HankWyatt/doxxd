{
  "name": "doxxd-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HankWyatt/doxxd.git",
    "directory": "web"
  },
  "homepage": "https://github.com/HankWyatt/doxxd#readme",
  "bugs": {
    "url": "https://github.com/HankWyatt/doxxd/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --workers=1",
    "contracts:generate": "openapi-typescript contracts/dmnd.openapi.yaml -o lib/dmnd/generated.ts && node scripts/generate-dmnd-validation.mjs",
    "acceptance:dmnd": "node scripts/dmnd-acceptance.mjs",
    "start:dmnd": "node scripts/run-dmnd.mjs",
    "verify:dmnd-runtime": "node scripts/verify-dmnd-runtime.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "bs58": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.43.0",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "js-yaml": "4.3.2",
    "jsdom": "^26.1.0",
    "json-rpc-2.0": "1.7.1",
    "openapi-typescript": "^7.10.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.1.6",
    "vitest": "4.1.12",
    "wrangler": "4.107.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "vinext": {
      "image-size": "2.0.3"
    }
  }
}
