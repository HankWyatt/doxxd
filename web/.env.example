# Server-only. Never use a NEXT_PUBLIC_ prefix for credentials.
DMND_API_BASE_URL=https://api.dmnd.dev/api/v1
DMND_API_KEY=
# Confirm serving/refresh qualification with DMND before enabling a protocol.
# Comma-separated resource IDs: stake,kamino,solend,marginfi,orca,raydium-clmm,
# meteora,raydium-cpmm,raydium-amm-v4,raydium-farms,liquid-staking,drift,velocity
DMND_ENABLED_PROTOCOLS=

# Optional operational controls; OMIT both for ordinary public wallet serving.
# DMND_ALLOWED_WALLETS=<comma-separated approved addresses>
# DMND_REQUEST_BUDGET=<integer 1..34, per runtime>

# On-site LP actions (connect a wallet, claim fees, withdraw). Server-only.
# Off unless this is exactly 1 AND SOLANA_RPC_URL is set: otherwise no wallet
# button, no action UI, and /api/rpc is 404.
# DOXXD_ACTIONS_ENABLED=1
# Required for actions: your Solana RPC provider's mainnet URL, behind the
# /api/rpc pass-through. There is no default: the public endpoint
# (api.mainnet-beta.solana.com) refuses requests from Cloudflare Workers.
# It usually carries an API key, so treat it as a server-only secret; it never
# reaches the browser or an error message.
# SOLANA_RPC_URL=
